# Tara — environment template. Copy to .env and fill in. NEVER commit .env.
#
# The app boots with this file as-is: every external integration defaults to a
# mock (MOCK_*=true), so no API keys are required to run locally. Set a MOCK_*
# flag to false and provide the matching credentials to use the real service.

# App
APP_ENV=development
PORT=3000

# Database (PostgreSQL) — async driver. Leave blank to use a local SQLite file.
# Any of these forms works; postgres://... and postgresql://... are auto-upgraded
# to the asyncpg driver. Missing tables are created automatically on app startup.
#   DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/tara
DATABASE_URL=

# Document store (MongoDB) — chat history + durable memory.
# Set MOCK_MONGO=false and run a local mongod to enable persistence.
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=tara
MOCK_MONGO=true

# Vector DB (ChromaDB) — host/port of the Chroma server
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Cache / queue (Redis — broker + result backend for Celery)
REDIS_URL=redis://localhost:6379/0

# LLM (OpenAI)
OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini
# Embedding model for the knowledge RAG dense (vector) retriever.
EMBEDDING_MODEL=text-embedding-ada-002

# Ephemeris / charts (hosted astrology API)
EPHEMERIS_API_URL=
EPHEMERIS_API_KEY=

# WhatsApp BSP (Gupshup / Wati / Twilio) + Channel
WHATSAPP_BSP_PROVIDER=gupshup
WHATSAPP_BSP_API_KEY=
WHATSAPP_CHANNEL_ID=

# Payments (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Geocoding / timezone (OpenCage / Google)
GEOCODING_API_KEY=

# ---- Mock switches (default true: run with no third-party credentials) ----
MOCK_OPENAI=true
MOCK_EPHEMERIS=true
MOCK_WHATSAPP=true
MOCK_RAZORPAY=true
MOCK_GEOCODING=true
MOCK_CHROMA=true

# ---- Owner / admin logins ----
# /admin + /console sign-in (POST /admin/login). A legacy "admin"/"chargemod"
# pair is also accepted by the app until it is removed from the admin router.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Shared secret for the X-Admin-Token header on admin API calls. Empty = the
# legacy "chargemod" token is accepted; set a random value in production:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
# Mobiles (comma-separated, matched on the last 10 digits) whose ordinary app
# session also authorizes the admin API and reveals the admin nav — no second
# login. Treat as a credential.
ADMIN_PHONES=
# Shared secret for scheduled cron endpoints (X-Cron-Token). Empty in dev =
# open locally; in production an empty value makes them 503 instead of running
# unprotected.
CRON_TOKEN=

# ---- Hosting ----
# Absolute origin the app is served from — share links and card images use it.
PUBLIC_BASE_URL=
# Hugging Face Space deploy credentials. NOT read by the app: they are only for
# pushing to / managing the Space (https://huggingface.co/settings/tokens).
HF_TOKEN=
HF_USERNAME=
HF_SPACE=
